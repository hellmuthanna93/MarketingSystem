        <div class="pricing-price" style="margin-bottom: 1.5rem;"><span class="amount" style="font-size: 3rem; font-weight: var(--font-weight-medium);">120€</span><span class="period" style="font-size: 0.95rem; color: var(--color-text-secondary);">/ 60 min session</span></div>
        <ul class="pricing-features" style="margin-bottom: 0; list-style: none; padding-left: 0; display: inline-block; text-align: left;">
          <li style="position: relative; padding-left: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text-secondary); font-weight: var(--font-weight-body);">For situational crisis counseling or a specific question</li>
          <li style="position: relative; padding-left: 1.5rem; margin-bottom: 0.75rem; color: var(--color-text-secondary); font-weight: var(--font-weight-body);">Useful as a focused follow-up after longer work</li>
          <li style="position: relative; padding-left: 1.5rem; margin-bottom: 0; color: var(--color-text-secondary); font-weight: var(--font-weight-body);">A flexible way to take a closer look at working together</li>
        </ul>
      </div>
    </div>
    <div style="margin-top: 2.5rem; text-align: center;">
      <a href="mailto:{{ contact.email }}?subject=Booking%20a%20counseling%20session" class="btn-primary">Book a counseling session</a>
    </div>
