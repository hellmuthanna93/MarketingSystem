<section class="quiz-hero{% if quiz_embedded %} quiz-hero--embedded{% endif %}">
  <div class="container quiz-hero__inner">
    <p class="quiz-eyebrow">Counseling or coaching?</p>
    {% if quiz_embedded %}
    <h2>What kind of support do I need right now?</h2>
    {% else %}
    <h1>What kind of support do I need right now?</h1>
    {% endif %}
    <p>
      This short quiz can help you understand which kind of support may fit
      your needs best right now.
    </p>
  </div>
</section>

<section class="quiz-section">
  <div class="container">
    <div class="quiz-shell" data-support-quiz>
      <div class="quiz-progress" aria-hidden="true">
        <div class="quiz-progress__bar" data-quiz-progress></div>
      </div>

      <div class="quiz-card" data-quiz-card>
        <p class="quiz-step" data-quiz-step>Question 1</p>
        <h2 data-quiz-question>What is the main reason you are here?</h2>
        <p class="quiz-help" data-quiz-help>Choose the answer that feels closest. You do not need to be perfectly sure.</p>
        <div class="quiz-options" data-quiz-options></div>
      </div>

      <div class="quiz-result" data-quiz-result hidden></div>
    </div>
  </div>
</section>

<script>
(() => {
  const calendarUrl = "https://calendar.app.google/ueKb9RbyxWyC6zfK8";

  const questions = {
    start: {
      question: "What is the main reason you are here?",
      help: "Choose the answer that feels closest. You do not need to be perfectly sure.",
      options: [
        {
          label: "I feel emotionally overwhelmed, anxious, numb, exhausted, frustrated, or sad. I want to feel better.",
          next: "lifeAreaEmotional",
          score: { counseling: 2 }
        },
        {
          label: "I know something needs to change in my career, business, or life direction. I want clarity and a concrete next step.",
          next: "lifeAreaEmotional",
          score: { coaching: 4 }
        },
        {
          label: "Both are true.",
          next: "lifeAreaEmotional",
          score: {}
        },
        {
          label: "I am in a complete crisis, unable to navigate my life on my own, and have a feeling I need immediate support.",
          result: "outside",
          score: { outside: 5 }
        }
      ]
    },
    lifeAreaEmotional: {
      question: "What is the main area in your life that leaves you unsatisfied?",
      help: "",
      options: [
        {
          label: "Relationship. I feel unhappy in my current relationship, lonely, or unable to build a stable relationship.",
          next: "mixedPrimary",
          score: { counseling: 3 }
        },
        {
          label: "Career, self-realisation, and money. I am unsatisfied with my job or business. It does not feel like a good fit, feels too stressful, does not bring me joy, or I feel stuck.",
          next: "mixedPrimary",
          score: { coaching: 3 }
        },
        {
          label: "Myself. I criticise myself, do not like my body, how I look, or my personality traits. I do not enjoy being myself.",
          next: "mixedPrimary",
          score: { counseling: 3 }
        },
        {
          label: "All areas of my life do not look the way I would like them to. Everything does not feel right.",
          next: "mixedPrimary",
          score: { counseling: 2 }
        },
        {
          label: "Something else.",
          next: "mixedPrimary",
          score: { counseling: 1 }
        }
      ]
    },
    mixedPrimary: {
      question: "How much energy do you have right now and how do you feel most of the time?",
      help: "",
      options: [
        {
          label: "I am mostly stable and able to navigate my day-to-day life.",
          next: "outcomeNeed",
          score: {},
          scoreWhenLeading: {
            coaching: { coaching: 2 },
            counseling: { counseling: 1 }
          }
        },
        {
          label: "I am functioning, but I have to force myself a lot. Everything costs a lot of energy and feels like Groundhog Day.",
          next: "outcomeNeed",
          score: {},
          scoreWhenLeading: {
            coaching: { coaching: 2 },
            counseling: { counseling: 1 }
          }
        },
        {
          label: "I am able to do only the most necessary things, and they leave me exhausted. A lot of my days are filled with worries and unpleasant feelings.",
          next: "outcomeNeed",
          score: { counseling: 2 }
        },
        {
          label: "Most of my day is filled with anxiety, sadness, and desperation. I am unable to accomplish my daily tasks and feel like a failure.",
          next: "outcomeNeed",
          score: { counseling: 3 }
        }
      ]
    },
    outcomeNeed: {
      question: "What outcome would feel most useful right now?",
      help: "",
      options: [
        {
          label: "I want to feel emotionally lighter and more stable.",
          next: "actionReadiness",
          score: { counseling: 2 }
        },
        {
          label: "I want to understand myself and my patterns better.",
          next: "actionReadiness",
          score: { counseling: 2 }
        },
        {
          label: "I want clear direction for my next chapter in life.",
          next: "actionReadiness",
          score: { coaching: 1 }
        },
        {
          label: "I want to start taking real steps in my career, business, or life.",
          next: "actionReadiness",
          score: { coaching: 2 }
        },
        {
          label: "I am not even sure what I want.",
          next: "actionReadiness",
          score: { counseling: 1 }
        }
      ]
    },
    actionReadiness: {
      question: "How much capacity do you have for action between sessions?",
      help: "",
      options: [
        {
          label: "I can take small steps if I have support and structure.",
          result: "auto",
          score: {}
        },
        {
          label: "I can reflect, but practical action feels difficult right now.",
          result: "auto",
          score: { counseling: 1 }
        },
        {
          label: "I want homework, experiments, and accountability.",
          result: "auto",
          score: { coaching: 1 }
        },
        {
          label: "I mostly need space to process and stabilize.",
          result: "auto",
          score: { counseling: 1 }
        },
        {
          label: "I am not sure yet.",
          result: "auto",
          score: {}
        }
      ]
    }
  };

  const results = {
    counseling: {
      eyebrow: "Your answers point toward",
      title: "Psychological counseling",
      text: "Your answers suggest that psychological counseling could be the right choice for your needs right now. It offers a confidential space to understand what you are going through, process it at your own pace, and build more emotional stability.",
      ctas: [
        { label: "Explore counseling", href: "{{ page_url('counseling') }}", className: "btn-secondary" },
        { label: "Schedule your discovery call", href: calendarUrl, className: "btn-primary", external: true }
      ]
    },
    coaching: {
      eyebrow: "Your answers point toward",
      title: "The Next Chapter coaching",
      text: "Your answers suggest that my coaching program could be exactly the right fit for you. The Next Chapter is a structured program that helps you move to a new level in your career, business, or wider life direction with confidence and alignment with yourself.",
      ctas: [
        { label: "Explore coaching", href: "{{ page_url('lifecoaching') }}", className: "btn-secondary" },
        { label: "Schedule your discovery call", href: calendarUrl, className: "btn-primary", external: true }
      ]
    },
    mixed: {
      eyebrow: "Your answers are mixed",
      title: "A discovery call is the best next step",
      text: "The best way to determine what fits you best is to schedule a discovery call. Together, we will clarify whether counseling, coaching, or another kind of support fits best right now.",
      cta: "Schedule your discovery call",
      href: calendarUrl
    },
    outside: {
      eyebrow: "You need more intense care",
      title: "Please seek local or emergency support",
      text: "Online counseling or coaching may not be the most suitable first step right now. It may be important to reach out to someone who can support you more intensively - for example, a doctor, emergency service, crisis hotline, psychiatric service, local psychotherapist, or a trusted person nearby. Do not stay in this alone. Ask for help."
    }
  };

  const quiz = document.querySelector("[data-support-quiz]");
  if (!quiz) return;

  const questionEl = quiz.querySelector("[data-quiz-question]");
  const helpEl = quiz.querySelector("[data-quiz-help]");
  const stepEl = quiz.querySelector("[data-quiz-step]");
  const optionsEl = quiz.querySelector("[data-quiz-options]");
  const progressEl = quiz.querySelector("[data-quiz-progress]");
  const cardEl = quiz.querySelector("[data-quiz-card]");
  const resultEl = quiz.querySelector("[data-quiz-result]");

  let current = "start";
  let history = [];
  let scores = { counseling: 0, coaching: 0, mixed: 0, outside: 0 };

  function addScore(score = {}, direction = 1) {
    Object.entries(score).forEach(([key, value]) => {
      scores[key] = (scores[key] || 0) + value * direction;
    });
  }

  function scoreLeader() {
    const counseling = scores.counseling || 0;
    const coaching = scores.coaching || 0;
    if (coaching > counseling) return "coaching";
    if (counseling > coaching) return "counseling";
    return "tie";
  }

  function getAppliedScore(option) {
    const appliedScore = { ...(option.score || {}) };
    const conditionalScore = option.scoreWhenLeading?.[scoreLeader()] || {};
    Object.entries(conditionalScore).forEach(([key, value]) => {
      appliedScore[key] = (appliedScore[key] || 0) + value;
    });
    return appliedScore;
  }

  function chooseResult(explicit) {
    if (explicit && explicit !== "auto") return explicit;
    if (scores.outside > 0) return "outside";
    const counseling = scores.counseling || 0;
    const coaching = scores.coaching || 0;
    const mixed = scores.mixed || 0;
    if (counseling > coaching) return "counseling";
    if (coaching > counseling) return "coaching";
    return "mixed";
  }

  function renderQuestion(id) {
    const question = questions[id];
    current = id;
    resultEl.hidden = true;
    resultEl.innerHTML = "";
    cardEl.hidden = false;
    stepEl.textContent = `Question ${history.length + 1}`;
    questionEl.textContent = question.question;
    const help = question.help.trim();
    helpEl.hidden = !help;
    helpEl.textContent = help;
    progressEl.style.transform = `scaleX(${Math.min(92, 12 + history.length * 14) / 100})`;
    optionsEl.innerHTML = "";

    question.options.forEach((option) => {
      const optionEl = document.createElement("div");
      const text = document.createElement("p");
      const button = document.createElement("button");
      optionEl.className = "quiz-option";
      text.className = "quiz-option__text";
      text.textContent = option.label;
      button.type = "button";
      button.className = "quiz-option__choose";
      button.textContent = "Choose";
      button.setAttribute("aria-label", `Choose: ${option.label}`);
      button.addEventListener("click", () => {
        const appliedScore = getAppliedScore(option);
        addScore(appliedScore);
        history.push({ id, option, appliedScore });
        if (option.result) {
          renderResult(chooseResult(option.result));
        } else {
          renderQuestion(option.next);
        }
      });
      optionEl.append(text, button);
      optionsEl.appendChild(optionEl);
    });
  }

  function renderResult(type) {
    const result = results[type];
    const ctas = result.ctas || (result.cta && result.href ? [{ label: result.cta, href: result.href, className: "btn-primary", external: true }] : []);
    const resultCtas = ctas.length
      ? `<div class="quiz-result__actions">${ctas.map((cta) => `<a class="${cta.className} quiz-result__cta" href="${cta.href}"${cta.external ? ' target="_blank" rel="noopener"' : ''}>${cta.label}</a>`).join("")}</div>`
      : "";
    cardEl.hidden = true;
    progressEl.style.transform = "scaleX(1)";
    resultEl.hidden = false;
    resultEl.innerHTML = `
      <p class="quiz-result__eyebrow">${result.eyebrow}</p>
      <h2>${result.title}</h2>
      <p>${result.text}</p>
      ${resultCtas}
    `;
  }

  renderQuestion(current);
})();
</script>
